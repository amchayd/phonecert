# Copy to .env (gitignored). One IMEI provider is enough.

# imei.info — register at https://dash.imei.info/register/, top up 5 USD, copy the key from the dashboard.
PHONECERT_IMEIINFO_KEY=
# Service ids called on every scan (comma separated). imei.info has no combined Apple check:
#   27 = BLACKLIST: Simple Check (0.20 USD)   8 = APPLE: Lock Status Check (0.20 USD)
# Others: 28 BLACKLIST Premium 0.42 · 2 APPLE Carrier & Lock & FMI 0.36 · 9 FMI 0.05 · 12 Warranty 0.10
PHONECERT_IMEIINFO_SERVICES=27,8

# sickw.com alternative (no public sign-up; account via first purchase / support). Service 61 is used.
PHONECERT_SICKW_KEY=
